<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="horizontal"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#ffffff"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#b0bec5"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/device_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#78909c"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_open_we"
            style="@style/TclFocusButton"
            android:text="@string/btn_open_we" />

        <Button
            android:id="@+id/btn_install_we"
            style="@style/TclFocusButton"
            android:text="@string/btn_install_we" />

        <Button
            android:id="@+id/btn_rescan"
            style="@style/TclFocusButton"
            android:text="@string/btn_rescan" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hint_import"
            android:textColor="#90a4ae"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mpkg_list"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:layout_weight="1.2"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:padding="8dp" />
</LinearLayout>
